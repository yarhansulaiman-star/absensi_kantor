<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1565C0"
                android:padding="20dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Input Data Gaji"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atur komponen gaji karyawan"
                    android:textColor="#BBDEFB"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- PILIH KARYAWAN -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih Karyawan"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"/>

                <Spinner
                    android:id="@+id/spinnerKaryawan"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"/>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- PILIH PERIODE -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih Periode"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Spinner
                        android:id="@+id/spinnerBulan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:layout_marginEnd="8dp"/>
                    <Spinner
                        android:id="@+id/spinnerTahun"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- KOMPONEN GAJI -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Komponen Gaji"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"/>

                <!-- Gaji Pokok -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gaji Pokok (Rp) *"
                    android:textColor="#555555"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etGajiPokok"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:hint="Contoh: 5000000"
                    android:paddingStart="12dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_marginBottom="12dp"/>

                <!-- Tunjangan Transport -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tunjangan Transport (Rp)"
                    android:textColor="#555555"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etTunjanganTransport"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:hint="Contoh: 500000"
                    android:paddingStart="12dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_marginBottom="12dp"/>

                <!-- Tunjangan Makan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tunjangan Makan (Rp)"
                    android:textColor="#555555"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etTunjanganMakan"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:hint="Contoh: 300000"
                    android:paddingStart="12dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_marginBottom="12dp"/>

                <!-- Tunjangan Jabatan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tunjangan Jabatan (Rp)"
                    android:textColor="#555555"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etTunjanganJabatan"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:hint="Contoh: 700000"
                    android:paddingStart="12dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_marginBottom="4dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TOMBOL SIMPAN -->
        <Button
            android:id="@+id/btnSimpanGaji"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SIMPAN DATA GAJI"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>