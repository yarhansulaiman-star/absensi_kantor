<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============ HEADER KARYAWAN ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1565C0"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvNamaKaryawan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Karyawan"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvJabatan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jabatan"
                    android:textColor="#BBDEFB"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvPeriode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Periode: -"
                    android:textColor="#BBDEFB"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============ PILIH PERIODE ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih Periode"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Spinner
                        android:id="@+id/spinnerBulan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:layout_marginEnd="8dp"/>

                    <Spinner
                        android:id="@+id/spinnerTahun"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"/>

                    <Button
                        android:id="@+id/btnCariGaji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cari"
                        android:backgroundTint="#1565C0"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============ PENGHASILAN ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Penghasilan"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:layout_marginBottom="10dp"/>

                <!-- Gaji Pokok -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Gaji Pokok"
                        android:textColor="#555555"/>
                    <TextView
                        android:id="@+id/tvGajiPokok"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textColor="#333333"/>
                </LinearLayout>

                <!-- Tunjangan Transport -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tunjangan Transport"
                        android:textColor="#555555"/>
                    <TextView
                        android:id="@+id/tvTunjanganTransport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textColor="#333333"/>
                </LinearLayout>

                <!-- Tunjangan Makan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tunjangan Makan"
                        android:textColor="#555555"/>
                    <TextView
                        android:id="@+id/tvTunjanganMakan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textColor="#333333"/>
                </LinearLayout>

                <!-- Tunjangan Jabatan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tunjangan Jabatan"
                        android:textColor="#555555"/>
                    <TextView
                        android:id="@+id/tvTunjanganJabatan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textColor="#333333"/>
                </LinearLayout>

                <!-- Uang Lembur -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Uang Lembur"
                        android:textColor="#555555"/>
                    <TextView
                        android:id="@+id/tvUangLembur"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textColor="#333333"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="8dp"/>

                <!-- Total Penghasilan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Penghasilan"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"/>
                    <TextView
                        android:id="@+id/tvTotalPenghasilan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============ POTONGAN ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Potongan"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#C62828"
                    android:layout_marginBottom="10dp"/>

                <!-- Potongan Terlambat -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Keterlambatan"
                        android:textColor="#555555"/>
                    <TextView
                        android:id="@+id/tvPotonganTerlambat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="- Rp 0"
                        android:textColor="#C62828"/>
                </LinearLayout>

                <!-- Detail Terlambat — diisi programatik dari GajiActivity -->
                <LinearLayout
                    android:id="@+id/layoutDetailTerlambat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFF8F8"
                    android:padding="8dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Potongan Alpha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Alpha (tidak hadir)"
                        android:textColor="#555555"/>
                    <TextView
                        android:id="@+id/tvPotonganAlpha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="- Rp 0"
                        android:textColor="#C62828"/>
                </LinearLayout>

                <!-- BPJS Kesehatan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BPJS Kesehatan (1%)"
                        android:textColor="#555555"/>
                    <TextView
                        android:id="@+id/tvBpjsKesehatan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="- Rp 0"
                        android:textColor="#C62828"/>
                </LinearLayout>

                <!-- BPJS TK -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BPJS Ketenagakerjaan (2%)"
                        android:textColor="#555555"/>
                    <TextView
                        android:id="@+id/tvBpjsTk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="- Rp 0"
                        android:textColor="#C62828"/>
                </LinearLayout>

                <!-- PPh21 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PPh 21 (5%)"
                        android:textColor="#555555"/>
                    <TextView
                        android:id="@+id/tvPph21"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="- Rp 0"
                        android:textColor="#C62828"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="8dp"/>

                <!-- Total Potongan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Potongan"
                        android:textStyle="bold"
                        android:textColor="#C62828"/>
                    <TextView
                        android:id="@+id/tvTotalPotongan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="- Rp 0"
                        android:textStyle="bold"
                        android:textColor="#C62828"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============ GAJI BERSIH ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1B5E20"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GAJI BERSIH"
                    android:textColor="#A5D6A7"
                    android:textSize="14sp"
                    android:letterSpacing="0.1"/>

                <TextView
                    android:id="@+id/tvGajiBersih"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 0"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- ============ TOMBOL INPUT GAJI (HRD ONLY) ============ -->
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnInputGaji"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Input Data Gaji Karyawan"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <!-- ============ TOMBOL EXPORT ============ -->
        <Button
            android:id="@+id/btnExportSlip"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Export Slip Gaji PDF"
            android:backgroundTint="#6A1B9A"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>