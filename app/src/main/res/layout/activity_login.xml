<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1F3D"
    tools:context=".ui.auth.LoginActivity">

    <!-- ══ BACKGROUND LOTTIE IKAN (fullscreen, looping) ══ -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieBackground"
        android:layout_width="350dp"
        android:layout_height="350dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:lottie_rawRes="@raw/office_worker"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:scaleType="fitCenter"
        android:alpha="0.55" />

    <!-- ══ OVERLAY GRADIENT (memberi kedalaman di atas animasi) ══ -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/bg_ocean" />

    <!-- ══ SCROLL CONTAINER ══ -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="640dp"
            android:background="@android:color/transparent">

            <!-- ══ LOGO ══ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLogo"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginTop="72dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="Logo" />

            </androidx.cardview.widget.CardView>

            <!-- ══ JUDUL ══ -->
            <TextView
                android:id="@+id/textJudul"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:text="Absensi Karyawan"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                app:layout_constraintTop_toBottomOf="@id/cardLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/textSubjudul"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:text="Masuk untuk melanjutkan"
                android:textSize="14sp"
                android:textColor="#CCFFFFFF"
                android:gravity="center"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                app:layout_constraintTop_toBottomOf="@id/textJudul"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ══ CARD FORM (TRANSPARAN / GLASSMORPHISM) ══ -->
            <!--
                CardView tidak mendukung alpha pada background secara native,
                gunakan MaterialCardView dengan cardBackgroundColor transparan
                dan border tipis untuk efek kaca.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF"
                app:strokeColor="#55FFFFFF"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/textSubjudul"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="24dp"
                    android:background="@android:color/transparent">

                    <!-- Judul form -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selamat Datang "
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Silakan masuk dengan akun Anda"
                        android:textSize="13sp"
                        android:textColor="#CCFFFFFF"
                        android:layout_marginBottom="20dp" />

                    <!-- Input Username (transparan, teks putih) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutUsername"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Username"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#AAFFFFFF"
                        app:boxBackgroundColor="#22FFFFFF"
                        app:hintTextColor="#CCFFFFFF"
                        app:startIconTint="#AAFFFFFF">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#88FFFFFF"
                            android:background="@android:color/transparent" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Input Password (transparan, teks putih) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Password"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#AAFFFFFF"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#AAFFFFFF"
                        app:boxBackgroundColor="#22FFFFFF"
                        app:hintTextColor="#CCFFFFFF">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone"
                            android:maxLines="1"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#88FFFFFF"
                            android:background="@android:color/transparent" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Label Error (transparan merah) -->
                    <TextView
                        android:id="@+id/labelError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:padding="10dp"
                        android:background="#44FF1744"
                        android:textSize="13sp"
                        android:textColor="#FFCDD2"
                        android:gravity="center"
                        android:visibility="gone"
                        tools:text="Username atau password salah!" />

                    <!-- Tombol MASUK -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombolLogin"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp"
                        android:text="MASUK"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0A1F3D"
                        app:backgroundTint="#E0F7FF"
                        app:cornerRadius="12dp"
                        app:rippleColor="#220F3460" />

                    <!-- Divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="4dp">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#55FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  atau  "
                            android:textSize="12sp"
                            android:textColor="#AAFFFFFF" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#55FFFFFF" />

                    </LinearLayout>

                    <!-- Tombol Daftar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombolRegister"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="4dp"
                        android:text="DAFTAR AKUN BARU"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#AAFFFFFF"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:rippleColor="#22FFFFFF" />


                    <!-- Lupa Password -->
                    <TextView
                        android:id="@+id/txtLupaPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="10dp"
                        android:padding="4dp"
                        android:text="Lupa Password?"
                        android:textSize="13sp"
                        android:textColor="#E0F7FF"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ══ PROGRESS BAR ══ -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/cardLogin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ══ FOOTER ══ -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:text="© 2026 Sistem Absensi Karyawan"
                android:textSize="11sp"
                android:textColor="#88FFFFFF"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/progressBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>