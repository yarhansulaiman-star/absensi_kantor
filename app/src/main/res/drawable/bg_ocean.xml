<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gradient atas (gelap → transparan) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#CC0A1F3D"
                android:endColor="#000A1F3D" />
        </shape>
    </item>

    <!-- Gradient bawah (transparan → gelap) -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#880A1F3D"
                android:endColor="#000A1F3D" />
            <size android:height="120dp" />
        </shape>
    </item>

</layer-list>